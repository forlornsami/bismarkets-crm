# Copy to the server's private environment file (never commit real values).
NODE_ENV=production
PORT=3000

# Dedicated MySQL user with rights on the CRM database only.
CRM_DATABASE_URL=mysql://crm:URL_ENCODED_PASSWORD@127.0.0.1:3306/bismarkets_crm

# 32 random bytes, base64. Generate with: node dist/cli.mjs generate-key
# Back it up securely: losing it means every staff member re-enrolls 2FA.
CRM_DATA_KEY=

# The admin panel's own address.
CRM_STAFF_ORIGIN=https://staff.crmbismarkets.com

# Office IPs, VPN exit IPs or CIDRs allowed to reach the staff panel and API.
CRM_STAFF_ALLOWED_IPS=203.0.113.10,198.51.100.0/24

# Proxies whose X-Forwarded-For is trusted: nginx on the same host, plus
# Cloudflare's ranges if Cloudflare sits in front. "false" trusts none.
CRM_TRUSTED_PROXIES=127.0.0.1

CRM_COOKIE_SECURE=true
CRM_SESSION_IDLE_MINUTES=15
CRM_SESSION_MAX_HOURS=8
CRM_STEPUP_MINUTES=5
CRM_LOGIN_MAX_FAILURES=5
CRM_LOGIN_LOCK_MINUTES=15
CRM_PASSWORD_BREACH_CHECK=true
CRM_LOG_LEVEL=info

# Client portal. Browsers may call the client API only from these origins.
CRM_PORTAL_URL=https://bismarkets.global
CRM_CLIENT_ORIGINS=https://bismarkets.global
CRM_PUBLIC_URL=https://crmbismarkets.com
CRM_CLIENT_SESSION_DAYS=30
CRM_CLIENT_IDLE_DAYS=7
CRM_IMPERSONATION_MINUTES=30

# Support service (bismarkets-support). The CRM sends it signed events: KYC
# decisions, account closed/reopened and sessions signed out. Use the same
# secret as its CLIENT_NOTIFICATION_CRM_SECRET (32+ characters) and the same
# environment as its CLIENT_NOTIFICATION_ENVIRONMENT. Empty URL = keep events
# queued without sending.
CRM_SUPPORT_EVENTS_URL=https://bismarkets.online
CRM_SUPPORT_EVENTS_SECRET=
CRM_SUPPORT_EVENTS_ENVIRONMENT=production

# MT5 gateway (a separate service on this server, docs/DEPLOY.md section 7).
# Empty URL = MT5 off: account lists answer from the database and every MT5
# change is refused as temporarily unavailable. The secret is the gateway's
# GATEWAY_SECRET (32+ characters).
CRM_MT5_GATEWAY_URL=
CRM_MT5_GATEWAY_SECRET=
# The UTC hour (0-23) of the nightly check of MT5 against the CRM's records.
CRM_MT5_RECONCILE_HOUR_UTC=2
