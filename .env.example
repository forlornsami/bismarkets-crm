# Copy to the server's private environment file (never commit real values).
NODE_ENV=production
PORT=3000

# Dedicated MySQL user with rights on the CRM database only.
CRM_DATABASE_URL=mysql://crm:URL_ENCODED_PASSWORD@127.0.0.1:3306/bismarkets_crm

# 32 random bytes, base64. Generate with: node dist/cli.mjs generate-key
# Back it up securely: losing it means every staff member re-enrolls 2FA.
CRM_DATA_KEY=

# The admin panel's own address.
CRM_STAFF_ORIGIN=https://staff.crmbismarkets.com

# Office IPs, VPN exit IPs or CIDRs allowed to reach the staff panel and API.
CRM_STAFF_ALLOWED_IPS=203.0.113.10,198.51.100.0/24

# Proxies whose X-Forwarded-For is trusted: nginx on the same host, plus
# Cloudflare's ranges if Cloudflare sits in front. "false" trusts none.
CRM_TRUSTED_PROXIES=127.0.0.1

CRM_COOKIE_SECURE=true
CRM_SESSION_IDLE_MINUTES=15
CRM_SESSION_MAX_HOURS=8
CRM_STEPUP_MINUTES=5
CRM_LOGIN_MAX_FAILURES=5
CRM_LOGIN_LOCK_MINUTES=15
CRM_PASSWORD_BREACH_CHECK=true
CRM_LOG_LEVEL=info
